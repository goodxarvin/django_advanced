[flake8]
# Ignore specific error codes
ignore = E203, W503

# Set maximum line length
max-line-length = 127

# Exclude directories and files
exclude =
    .git,
    __pycache__,
    build,
    dist,
    venv
    settings.py
    __init__


# McCabe complexity threshold
max-complexity = 10

# Per-file ignores
per-file-ignores =
    tests/*:D100,D101,D102   